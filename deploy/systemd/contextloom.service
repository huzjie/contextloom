[Unit]
Description=ContextLoom document intelligence service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/contextloom
ExecStart=/opt/contextloom/.venv/bin/contextloom serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
