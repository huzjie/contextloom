# ContextLoom 环境配置示例：复制为 .env 后按需修改
CLOOM_ENV=dev
CLOOM_LOG_LEVEL=INFO
CLOOM_HOST=0.0.0.0
CLOOM_PORT=8000
CLOOM_DATA_DIR=./data

# 本地大模型后端：ollama | llamacpp | vllm | sglang | openai | mock
CLOOM_LLM_BACKEND=ollama
CLOOM_LLM_MODEL=qwen3:8b
CLOOM_LLM_BASE_URL=http://localhost:11434
CLOOM_LLM_API_KEY=
CLOOM_LLM_TEMPERATURE=0.2
CLOOM_LLM_MAX_TOKENS=8192
# 端侧百万上下文模型可调大
CLOOM_LLM_CONTEXT_WINDOW=131072
CLOOM_LLM_TIMEOUT_SECONDS=300.0

# 向量后端：sqlite | faiss | memory
CLOOM_VECTOR_BACKEND=sqlite
CLOOM_EMBED_MODEL=BAAI/bge-small-zh-v1.5
CLOOM_EMBED_DIM=512
CLOOM_EMBED_ALLOW_HASH_FALLBACK=true

# 分块与检索
CLOOM_CHUNK_SIZE=1024
CLOOM_CHUNK_OVERLAP=128
CLOOM_CHUNK_STRATEGY=recursive
CLOOM_TOP_K=8
CLOOM_RERANK_ENABLED=false

CLOOM_QUEUE_MAX_CONCURRENCY=2
